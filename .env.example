# Application
APP_ENV=development
DEBUG=false

# Server (uvicorn)
HOST=127.0.0.1
PORT=8000

# Database
# SQLite (default): sqlite+aiosqlite:///./database.db
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/taxshare
DATABASE_URL=sqlite+aiosqlite:///./database.db
SQL_ECHO=false
